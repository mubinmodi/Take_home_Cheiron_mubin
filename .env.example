# Environment template. Copy to .env (never committed) and fill in:
#   cp .env.example .env
# Every value except the API keys has a working default; delete a line to use the default.

# --- Planner model credentials -------------------------------------------------
# Read directly by the provider SDKs. Set at least one; a model without a key is skipped.
# With no key at all the service still starts, and questions return internal_error.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Gemini API key (GEMINI_API_KEY is also accepted).
GOOGLE_API_KEY=

# --- Planner models --------------------------------------------------------------
# pydantic-ai "provider:model" strings. Change models here, not in code.
# The fallback is used only on provider errors (timeouts, 5xx, rate limits).
# Leave PLANNER_FALLBACK empty to disable it. Any provider can fill either slot.
# Keep both slots in the same tier (roughly equivalent models, see MODEL_TIERS in config.py):
#
#   tier  OpenAI (allowed list)                     Anthropic                    Google Gemini
#   nano  openai:gpt-5.4-nano  (4.1-nano, 4o-mini)   anthropic:claude-haiku-4-5   google:gemini-3.5-flash-lite
#   mini  openai:gpt-5.4-mini  (5-mini, 4.1-mini)    anthropic:claude-haiku-4-5   google:gemini-3.5-flash
#   full  openai:gpt-5.4  (5.2, 5.1, 5, 4.1, 4o)    anthropic:claude-sonnet-5-5  google:gemini-3.1-pro-preview
#
# OpenAI models outside the allowed list log a warning at startup.
PLANNER_PRIMARY=openai:gpt-5.4-mini
PLANNER_FALLBACK=anthropic:claude-haiku-4-5
# Each model attempt may take this long (one quick retry), then the fallback model is tried.
# The whole planning step, fallback included, has a deadline.
PLANNER_TIMEOUT_SECONDS=20
PLANNER_DEADLINE_SECONDS=60

# --- ClinicalTrials.gov API --------------------------------------------------------
CTGOV_BASE_URL=https://clinicaltrials.gov/api/v2
# Requests per minute from this process; the reported public limit is ~50 per IP.
CTGOV_REQUESTS_PER_MINUTE=40
CTGOV_TIMEOUT_SECONDS=30
# Pages of 1,000 trials fetched per question. Larger cohorts return scope_required.
MAX_PAGES=20

# --- Service -------------------------------------------------------------------------
# Where run records (plan + response per run) are saved.
RUNS_DIR=data/runs
# Base of chart_url links. Leave unset to use the address each request arrives on;
# set it when clients reach the service by another address (e.g. a custom domain).
# PUBLIC_BASE_URL=https://trials.example.org
# Drawing one chart image may take this long before the request returns 504.
RENDER_TIMEOUT_SECONDS=30
# WARNING shows model failures, source errors and bugs (with run IDs); INFO adds every HTTP request.
LOG_LEVEL=WARNING

# --- Tracing (OpenTelemetry) ------------------------------------------------------
# none | console | otlp
OTEL_EXPORTER=none
# Used when OTEL_EXPORTER=otlp (OpenTelemetry standard variable).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Hosted mode (docs/hosted-deployment.md) --------------------------------------------
# Leave everything below unset for local use. DEPLOYMENT=hosted refuses to start without
# REDIS_URL, DATABASE_URL and API_KEYS, and defaults the per-user limit (30 questions/hour)
# and the run deadline (30 s). On AWS the secrets come from Secrets Manager (deploy/aws/).
# DEPLOYMENT=hosted
# Redis (ElastiCache on AWS; rediss:// for TLS): page cache, one shared rate limit, Idempotency-Keys.
# REDIS_URL=rediss://default:PASSWORD@HOST:6379
# Postgres (RDS on AWS): run history (Follow-ups and chart links read it).
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DB?ssl=require
# Comma-separated name:key pairs (keys of 16+ characters). POST /v1/query then needs X-API-Key.
# API_KEYS=alice:CHANGE-ME-TO-A-LONG-RANDOM-KEY
# USER_QUERIES_PER_HOUR=30
# RUN_DEADLINE_SECONDS=30
# Circuit breakers: this many outage-type failures in a row stop calls for the cool-down.
# BREAKER_FAILURES=5
# BREAKER_COOLDOWN_SECONDS=30
