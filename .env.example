# Copy to .env and fill in. API keys are read by the provider SDKs.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Planner models as pydantic-ai "provider:model" strings. Change models here, not in code.
PLANNER_PRIMARY=openai:gpt-5.4-mini
PLANNER_FALLBACK=anthropic:claude-sonnet-5-5

# none | console | otlp (OTLP endpoint via OTEL_EXPORTER_OTLP_ENDPOINT)
OTEL_EXPORTER=none
